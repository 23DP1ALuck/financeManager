# Placeholders only. Use your own empty local development database.
# URL-encode special characters in the username/password.
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/finance_demo"
NEXTAUTH_URL="http://localhost:3000"
# Generate a private value with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Optional: needed only to test the corresponding OAuth button.
GOOGLE_ID=""
GOOGLE_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# Required when using Docker Compose. Choose distinct private passwords.
MYSQL_ROOT_PASSWORD=""
MYSQL_PASSWORD=""
