generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  user_id       Int            @id @default(autoincrement())
  username      String         @unique
  email         String
  password      String
  date_of_birth DateTime
  accounts      accounts[]
  transactions  transactions[]
}

model accounts {
  account_id   Int            @id @default(autoincrement())
  name         WALLETS
  balance      Float
  user_id      Int
  isPrimary    Boolean        @default(false)
  user         users          @relation(fields: [user_id], references: [user_id])
  transactions transactions[]

  @@index([user_id], map: "accounts_user_id_fkey")
}

model categories {
  category_id  Int            @id @default(autoincrement())
  name         CATEGORY_NAME
  budgets      budgets[]
  transactions transactions[]
}

model budgets {
  budget_id   Int        @id @default(autoincrement())
  amount      Float
  category_id Int
  category    categories @relation(fields: [category_id], references: [category_id])

  @@index([category_id], map: "budgets_category_id_fkey")
}

model transactions {
  transaction_id          Int        @id @default(autoincrement())
  amount                  Float
  date                    DateTime   @default(now())
  account_id              Int
  category_id             Int
  user_id                 Int
  transaction_description String
  transaction_name        String
  account                 accounts   @relation(fields: [account_id], references: [account_id])
  category                categories @relation(fields: [category_id], references: [category_id])
  user                    users      @relation(fields: [user_id], references: [user_id])

  @@index([account_id], map: "transactions_account_id_fkey")
  @@index([category_id], map: "transactions_category_id_fkey")
  @@index([user_id], map: "transactions_user_id_fkey")
}

enum WALLETS {
  Swedbank
  Seb
  Citadele
  Revolut
  Wise
  Cash
  Other
}

enum CATEGORY_NAME {
  Food
  Entertainment
  Subscribtions
  Transport
  Education
  Other
}
